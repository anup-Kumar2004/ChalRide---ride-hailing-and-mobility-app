<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ═══════════════════════════════════════════
         FULL-SCREEN MAP — always bottom layer
    ═══════════════════════════════════════════ -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Top scrim gradient — fades map into card -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_map_top_scrim"
        android:layout_gravity="top"/>

    <!-- ═══════════════════════════════════════════
         TOP LABEL CARD — phase + address
    ═══════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTopLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Phase pill -->
            <TextView
                android:id="@+id/tvPhaseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEADING TO PICKUP"
                android:textColor="@color/brand_primary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:background="@drawable/bg_phase_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"/>

            <!-- Target address -->
            <TextView
                android:id="@+id/tvCurrentTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- ═══════════════════════════════════════════
     NAVIGATE BUTTON
    ═══════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNavigate"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="238dp"
        android:text="Navigate to Pickup"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        app:icon="@drawable/ic_navigation_arrow"
        app:iconSize="15dp"
        android:visibility="gone"
        android:elevation="12dp"
        app:cornerRadius="15dp"
        app:backgroundTint="@color/bg_card"
        app:strokeColor="@color/brand_primary"
        app:strokeWidth="1dp"/>




    <!-- ═══════════════════════════════════════════
         BOTTOM DETAILS SHEET — fixed, no drag handle
    ═══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ride_confirm_sheet"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- ── Row 1: Fare + vehicle badge ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvFare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹0"
                    android:textColor="@color/success_color"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"/>

                <!-- Payment mode badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CASH"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_role_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvVehicleType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_role_badge"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="AUTO"/>

            </LinearLayout>

            <!-- ── Row 2: Rider info strip ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="16dp">

                <!-- Avatar initial circle -->
                <TextView
                    android:id="@+id/tvRiderAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="R"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRiderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Rider"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your passenger"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ── Divider ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"/>

            <!-- ── Route summary: pickup → destination ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp">

                <!-- Green pickup dot -->
                <View
                    android:id="@+id/dotPickup"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot_online"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvPickupAddress"
                    app:layout_constraintBottom_toBottomOf="@id/tvPickupAddress"/>

                <!-- Connector line -->
                <View
                    android:id="@+id/connectorLine"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:background="@color/text_hint"
                    android:alpha="0.3"
                    app:layout_constraintStart_toStartOf="@id/dotPickup"
                    app:layout_constraintEnd_toEndOf="@id/dotPickup"
                    app:layout_constraintTop_toBottomOf="@id/dotPickup"
                    app:layout_constraintBottom_toTopOf="@id/dotDest"/>

                <!-- Red destination dot -->
                <View
                    android:id="@+id/dotDest"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_destination_dot"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvDestAddress"
                    app:layout_constraintBottom_toBottomOf="@id/tvDestAddress"/>

                <TextView
                    android:id="@+id/tvPickupAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginStart="14dp"
                    app:layout_constraintStart_toEndOf="@id/dotPickup"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tvDestAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toEndOf="@id/dotDest"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPickupAddress"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>