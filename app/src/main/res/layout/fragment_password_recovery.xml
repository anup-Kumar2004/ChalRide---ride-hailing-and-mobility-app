<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- ── Step label ───────────────────────────────────────────────  ─ -->
        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:text="ACCOUNT RECOVERY"
            android:textColor="#806C63FF"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ═══════════════════════════════════════════════════════════════
             STATE 1: INPUT STATE (email entry)
             Toggled VISIBLE/GONE by the Fragment
        ════════════════════════════════════════════════════════════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvStepLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Icon container with pulse ring behind it -->
            <FrameLayout
                android:id="@+id/frameIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">

                <!-- Pulse ring (animated, sits behind the icon) -->
                <View
                    android:id="@+id/viewPulseRing"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_pulse_ring"
                    android:layout_gravity="center"/>

                <!-- Icon circle bg -->
                <ImageView
                    android:id="@+id/ivEmailIcon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_email_signal"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:contentDescription="Email recovery icon"/>

            </FrameLayout>

            <!-- Gradient divider line -->
            <View
                android:id="@+id/dividerLine"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@drawable/bg_divider_gradient"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@id/frameIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Headline -->
            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Forgot your\npassword?"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/dividerLine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Sub-headline -->
            <TextView
                android:id="@+id/tvSubHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="No worries. Enter your registered email and we'll beam a reset link straight to your inbox."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeadline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Email input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/ChalRide.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Your email address"
                android:layout_marginTop="32dp"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="@color/brand_primary"
                app:layout_constraintTop_toBottomOf="@id/tvSubHeadline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:paddingVertical="16dp"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error text -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/error_color"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tilEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Send reset button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendReset"
                style="@style/ChalRide.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Send Reset Link"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvError"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:indeterminateTint="@color/brand_primary"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnSendReset"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Back to login link -->
            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back to login"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/progressBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ═══════════════════════════════════════════════════════════════
             STATE 2: SUCCESS STATE (email sent confirmation)
             Starts GONE, becomes VISIBLE after email is dispatched
        ════════════════════════════════════════════════════════════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:alpha="0"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvStepLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Success icon (envelope + check) -->
            <ImageView
                android:id="@+id/ivSuccessIcon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_email_sent"
                android:scaleType="fitCenter"
                android:contentDescription="Email sent"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Success badge pill -->
            <TextView
                android:id="@+id/tvSuccessBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  LINK SENT"
                android:textColor="@color/success_color"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_role_badge"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/ivSuccessIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Success headline -->
            <TextView
                android:id="@+id/tvSuccessHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Check your inbox"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvSuccessBadge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Email address display -->
            <TextView
                android:id="@+id/tvSentToEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/brand_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tvSuccessHeadline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Success body text -->
            <TextView
                android:id="@+id/tvSuccessBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="A password reset link is on its way. It may take a minute or two. Check your spam folder if you don't see it."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:gravity="center"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvSentToEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Gradient divider -->
            <View
                android:id="@+id/dividerSuccess"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@drawable/bg_divider_gradient"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvSuccessBody"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Return to login button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturnToLogin"
                style="@style/ChalRide.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Back to Login"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/dividerSuccess"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Resend area — shows cooldown timer first, then the resend link -->
            <!-- During cooldown: tvResendCooldown is VISIBLE, tvResendLink is GONE -->
            <!-- After cooldown:  tvResendCooldown is GONE,    tvResendLink is VISIBLE -->
            <LinearLayout
                android:id="@+id/resendArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/btnReturnToLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Shown during the 30-second cooldown -->
                <TextView
                    android:id="@+id/tvResendCooldown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend available in 30s"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:visibility="gone"/>

                <!-- Shown after cooldown expires -->
                <TextView
                    android:id="@+id/tvResendLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Didn't receive it? Resend"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>