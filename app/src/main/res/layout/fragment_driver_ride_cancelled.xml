<?xml version="1.0" encoding="utf-8"?>
<!--
    ADAPTIVE LAYOUT — fragment_driver_ride_cancelled.xml
    =====================================================
    Strategy:
      • Root ConstraintLayout holds the top accent bar + two buttons anchored to
        the bottom.  These never move regardless of screen size.
      • A NestedScrollView fills the space between the accent bar and the buttons
        (fillViewport="true").  On large screens the inner ConstraintLayout
        expands to fill the scroll view and the packed vertical chain with
        vertical_bias="0.40" reproduces the "slightly above centre" Figma look.
        On small screens the content simply scrolls — nothing is ever buried
        behind the buttons.
      • The three glow/ring layers + icon are stacked inside a FrameLayout so
        no circular ConstraintLayout constraints are needed.
      • Glow container trimmed from 260 dp → 210 dp to reclaim ~50 dp on small
        screens while looking identical on large ones.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <!-- ── Top accent bar (always at the very top) ─────────────────────── -->
    <View
        android:id="@+id/topAccentBar"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@drawable/gradient_red_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── Scrollable content area ──────────────────────────────────────── -->
    <!--
        fillViewport="true"  → on large screens the inner ConstraintLayout is
        expanded to fill the scroll view height, making the vertical chain +
        bias work for centering.
        On small screens the inner CL wraps its content and the scroll view
        just scrolls it — buttons remain always visible.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topAccentBar"
        app:layout_constraintBottom_toTopOf="@id/btnBackToHome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            Inner ConstraintLayout:
              • wrap_content height → grows with content, allowing scroll on
                small screens.
              • fillViewport on the NestedScrollView will stretch this to at
                least the scroll view height on large screens.
              • All content views form ONE vertical chain
                (top=parent ↔ bottom=parent) with chainStyle=packed +
                vertical_bias=0.40 → content sits slightly above centre,
                matching the Figma design.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ── Glow rings + icon (FrameLayout stacks them cleanly) ─── -->
            <!--
                This is the TOP of the vertical chain.
                top_toTopOf=parent + bottom_toTopOf=tvStatusBadge, with
                chainStyle=packed and vertical_bias=0.40 on THIS view.
            -->
            <FrameLayout
                android:id="@+id/glowContainer"
                android:layout_width="210dp"
                android:layout_height="210dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvStatusBadge"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.40">

                <!-- Outer glow ring -->
                <View
                    android:id="@+id/glowRingOuter"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:alpha="0.35"
                    android:background="@drawable/bg_glow_ring_outer" />

                <!-- Middle ring -->
                <View
                    android:id="@+id/glowRingMiddle"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:alpha="0.55"
                    android:background="@drawable/bg_glow_ring_middle" />

                <!-- Icon circle background -->
                <View
                    android:id="@+id/iconCircleBg"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_circle" />

                <!-- Cancel icon -->
                <ImageView
                    android:id="@+id/ivCancelIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ride cancelled"
                    android:src="@drawable/ic_cancel_x" />

            </FrameLayout>

            <!-- ── "TRIP UPDATE" status badge ───────────────────────────── -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_status_badge"
                android:fontFamily="@font/geist_mono_regular"
                android:letterSpacing="0.12"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="TRIP UPDATE"
                android:textColor="@color/error_red"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/glowContainer"
                app:layout_constraintBottom_toTopOf="@id/tvTitle" />

            <!-- ── Title ─────────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/geist_bold"
                android:letterSpacing="-0.02"
                android:text="Rider Cancelled"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStatusBadge"
                app:layout_constraintBottom_toTopOf="@id/tvMessage" />

            <!-- ── Subtitle / message ────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="40dp"
                android:fontFamily="@font/geist_mono_regular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.55"
                android:text="The rider has cancelled this trip.\nYou are now available for new ride requests."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintBottom_toTopOf="@id/divider" />

            <!-- ── Divider line ───────────────────────────────────────────── -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="32dp"
                android:background="@drawable/divider_gradient"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMessage"
                app:layout_constraintBottom_toTopOf="@id/infoCard" />

            <!-- ── Info card ──────────────────────────────────────────────── -->
            <!--
                BOTTOM of the vertical chain → bottom_toBottomOf=parent.
                marginBottom="28dp" gives breathing room above the buttons on
                large screens; on small screens it's simply the last scrollable
                element.
            -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/infoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_info_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/icInfoDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_status_available"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvInfoLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/geist_medium"
                    android:text="Your status is now active"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toTopOf="@id/tvInfoSub"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icInfoDot"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvInfoSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/geist_regular"
                    android:text="Listening for new nearby requests"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icInfoDot"
                    app:layout_constraintTop_toBottomOf="@id/tvInfoLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Primary CTA — always anchored to bottom of root ──────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToHome"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/geist_semibold"
        android:letterSpacing="0.02"
        android:text="Back to Home"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/error_red"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_home_outline"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/btnViewEarnings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="#33FFFFFF" />

    <!-- ── Secondary ghost button — always anchored to bottom of root ───── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewEarnings"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="28dp"
        android:fontFamily="@font/geist_medium"
        android:text="View Today's Earnings"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="#1AFFFFFF"
        app:strokeColor="@color/stroke_subtle"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>