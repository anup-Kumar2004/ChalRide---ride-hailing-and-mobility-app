<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_ride_details.xml
    Screen: RideDetailsFragment  —  shows full details of the current ongoing ride.
    Design: dark‑luxury card system matching ChalRide's brand palette.
             bg_dark (#0F0F1A) base · bg_card (#1A1A2E) cards ·
             brand_primary (#6C63FF) accent · brand_accent (#4ECDC4) secondary accent
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ══════════════════════════════════════════════════════════
         TOP APP BAR
    ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_primary"
            app:title="Ride Details"
            app:titleTextColor="@color/text_primary"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:background="@color/bg_dark"/>

        <!-- Subtle purple underline beneath toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2D6C63FF"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════════════════════
         SCROLLABLE BODY
    ══════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp">

            <!-- ══════════════════════════════════════════════════
                 SECTION 1 — LIVE STATUS BANNER
            ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A6C63FF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#336C63FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- Animated pulse dot -->
                    <View
                        android:id="@+id/viewDetailsDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_dot"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE TRACKING"
                            android:textColor="#806C63FF"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.14"/>

                        <TextView
                            android:id="@+id/tvDetailStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your driver is on the way"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                    <!-- Phase badge -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#226C63FF"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvDetailPhase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PICKUP"
                            android:textColor="@color/brand_primary"
                            android:textSize="8.5sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.10"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"/>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════
                 SECTION 2 — DRIVER PROFILE CARD
            ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <!-- Section header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR DRIVER"
                        android:textColor="@color/text_hint"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.14"
                        android:layout_marginBottom="16dp"/>

                    <!-- Driver avatar + name row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <!-- Avatar: Cloudinary photo OR initials fallback -->
                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginEnd="16dp">

                            <!-- Gradient ring around avatar -->
                            <View
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_avatar_ring"
                                android:layout_gravity="center"/>

                            <!-- Photo (loaded via Glide; GONE when no URL) -->
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/imgDriverPhoto"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_gravity="center"
                                android:src="@color/bg_surface"
                                app:civ_border_width="0dp"
                                android:visibility="gone"/>

                            <!-- Initials fallback (VISIBLE when no photo URL) -->
                            <TextView
                                android:id="@+id/tvDriverInitial"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_driver_avatar_inner"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:fontFamily="sans-serif-bold"
                                android:visibility="visible"/>

                        </FrameLayout>

                        <!-- Name + vehicle type + verified badge -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailDriverName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Driver"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="3dp"/>

                            <TextView
                                android:id="@+id/tvDetailVehicleType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vehicle type"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                android:layout_marginBottom="8dp"/>

                            <!-- Verified + Rating row -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="#1A4ECDC4"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="0dp">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="4dp"
                                        android:paddingBottom="4dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="🛡️"
                                            android:textSize="9sp"
                                            android:layout_marginEnd="3dp"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Verified"
                                            android:textColor="@color/brand_accent"
                                            android:textSize="9sp"
                                            android:fontFamily="sans-serif-medium"/>

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                                <!-- Total trips pill -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    app:cardBackgroundColor="#1AFFFFFF"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="0dp">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="4dp"
                                        android:paddingBottom="4dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="🏁"
                                            android:textSize="9sp"
                                            android:layout_marginEnd="3dp"/>

                                        <TextView
                                            android:id="@+id/tvTotalTrips"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0 trips"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="9sp"
                                            android:fontFamily="sans-serif-medium"/>

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Thin separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginBottom="16dp"/>

                    <!-- Driver contact info — phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <!-- Icon bubble -->
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_info_icon_bubble"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_call"/>

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PHONE"
                                android:textColor="@color/text_hint"
                                android:textSize="8.5sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.10"/>

                            <TextView
                                android:id="@+id/tvDriverPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="1dp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginBottom="14dp"/>

                    <!-- Vehicle section label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VEHICLE INFORMATION"
                        android:textColor="@color/text_hint"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.14"
                        android:layout_marginBottom="14dp"/>

                    <!-- Vehicle details 2-column grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Model -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_vehicle_detail_cell"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MODEL"
                                android:textColor="@color/text_hint"
                                android:textSize="8sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.10"/>

                            <TextView
                                android:id="@+id/tvVehicleModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="3dp"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                        </LinearLayout>

                        <!-- Color -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_vehicle_detail_cell"
                            android:padding="12dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COLOR"
                                android:textColor="@color/text_hint"
                                android:textSize="8sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.10"/>

                            <TextView
                                android:id="@+id/tvVehicleColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="3dp"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Registration plate — full width premium pill -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#0D6C63FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#336C63FF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🪪"
                                android:textSize="16sp"
                                android:layout_marginEnd="12dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="REGISTRATION PLATE"
                                    android:textColor="@color/text_hint"
                                    android:textSize="8sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.10"/>

                                <TextView
                                    android:id="@+id/tvVehiclePlate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-- -- -- ----"
                                    android:textColor="@color/brand_primary"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-bold"
                                    android:letterSpacing="0.08"
                                    android:layout_marginTop="2dp"/>

                            </LinearLayout>

                            <!-- "Look for" hint -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Look\nfor this"
                                android:textColor="#606080"
                                android:textSize="8.5sp"
                                android:gravity="end"
                                android:fontFamily="sans-serif"/>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════
                 SECTION 3 — ROUTE DETAILS CARD
            ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROUTE"
                        android:textColor="@color/text_hint"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.14"
                        android:layout_marginBottom="18dp"/>

                    <!-- Pickup row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <!-- Timeline column -->
                        <LinearLayout
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="14dp"
                            android:layout_marginTop="10dp">

                            <!-- Pickup dot (brand_primary filled) -->
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_pickup_dot"/>

                            <!-- Dashed vertical line -->
                            <View
                                android:layout_width="2dp"
                                android:layout_height="45dp"
                                android:background="#336C63FF"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp"/>

                            <!-- Destination dot (teal) -->
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_dest_dot"/>

                        </LinearLayout>

                        <!-- Address texts -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Pickup -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="32dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PICKUP"
                                    android:textColor="@color/text_hint"
                                    android:textSize="8sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.10"
                                    android:layout_marginBottom="3dp"/>

                                <TextView
                                    android:id="@+id/tvDetailPickupAddress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Pickup location"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:maxLines="2"
                                    android:ellipsize="end"/>

                            </LinearLayout>

                            <!-- Destination -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DESTINATION"
                                    android:textColor="@color/text_hint"
                                    android:textSize="8sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.10"
                                    android:layout_marginBottom="3dp"/>

                                <TextView
                                    android:id="@+id/tvDetailDestAddress"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Destination"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="2"
                                    android:ellipsize="end"/>

                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════
                 SECTION 4 — FARE & TRIP STATS ROW
            ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Fare card (2/3 width) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💳"
                                android:textSize="14sp"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ESTIMATED FARE"
                                android:textColor="@color/text_hint"
                                android:textSize="8.5sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.10"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailFare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹--"
                            android:textColor="@color/brand_primary"
                            android:textSize="30sp"
                            android:fontFamily="sans-serif-bold"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cash · Inclusive of all taxes"
                            android:textColor="@color/text_hint"
                            android:textSize="9.5sp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Payment mode card (1/3 width) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💵"
                            android:textSize="24sp"
                            android:layout_marginBottom="6dp"
                            android:layout_gravity="center_horizontal"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PAYMENT"
                            android:textColor="@color/text_hint"
                            android:textSize="8sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.10"
                            android:layout_marginBottom="3dp"
                            android:layout_gravity="center_horizontal"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cash"
                            android:textColor="@color/success_color"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_gravity="center_horizontal"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════
                 SECTION 5 — SAFETY CARD
            ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSafety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#0D4ECDC4"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#334ECDC4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAFETY TIPS"
                            android:textColor="@color/brand_accent"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"/>

                    </LinearLayout>

                    <!-- Tip 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/bg_status_dot"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verify the plate number before boarding"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp"/>

                    </LinearLayout>

                    <!-- Tip 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/bg_status_dot"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Only share OTP with your driver — never online"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp"/>

                    </LinearLayout>

                    <!-- Tip 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:background="@drawable/bg_status_dot"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Share your ride status with a trusted contact"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════
                 SECTION 6 — RIDE ID CARD  (support reference)
            ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RIDE ID"
                            android:textColor="@color/text_hint"
                            android:textSize="8.5sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.10"/>

                        <TextView
                            android:id="@+id/tvRideId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:ellipsize="middle"/>

                    </LinearLayout>

                    <!-- Copy icon hint -->
                    <TextView
                        android:id="@+id/tvCopyRideId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="16sp"
                        android:paddingStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>