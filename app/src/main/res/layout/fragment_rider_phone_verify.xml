<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <!-- ── Step indicator ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/stepDot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_online" />

            <View
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/divider_color" />

            <View
                android:id="@+id/stepDot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_otp_box" />

        </LinearLayout>

        <!-- ── Lock icon ───────────────────────────────────── -->
        <TextView
            android:id="@+id/tvLockIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="🔐"
            android:textSize="32sp"
            android:gravity="center"
            android:background="@color/input_bg"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/layoutStepIndicator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ── PHONE STEP views ────────────────────────────── -->

        <TextView
            android:id="@+id/tvPhoneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Verify your number"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvLockIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvPhoneSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="We'll send a 6-digit code to confirm\nyour phone number"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ── Phone input row ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutPhoneInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- +91 country pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_phone_flag_pill"
                android:layout_marginEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇮🇳"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" +91"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <!-- Phone number field -->
            <LinearLayout
                android:id="@+id/containerPhoneField"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_phone_input_container">

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="10-digit mobile number"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:background="@null"
                    android:letterSpacing="0.05" />

            </LinearLayout>

        </LinearLayout>

        <!-- Phone error -->
        <TextView
            android:id="@+id/tvPhoneError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/error_color"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/layoutPhoneInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Send OTP button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendOtp"
            style="@style/ChalRide.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Send OTP"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneError"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ── OTP STEP views (hidden initially) ──────────── -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutOtpStep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvLockIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvOtpTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Enter the code"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvOtpSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sent to +91 XXXXXXXXXX"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvOtpTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- 6 OTP boxes -->
            <LinearLayout
                android:id="@+id/layoutOtpBoxes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@id/tvOtpSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/etOtp1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:cursorVisible="false" />

                <EditText
                    android:id="@+id/etOtp2"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:cursorVisible="false" />

                <EditText
                    android:id="@+id/etOtp3"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:cursorVisible="false" />

                <EditText
                    android:id="@+id/etOtp4"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:cursorVisible="false" />

                <EditText
                    android:id="@+id/etOtp5"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:cursorVisible="false" />

                <EditText
                    android:id="@+id/etOtp6"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxLength="1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:cursorVisible="false" />

            </LinearLayout>

            <!-- OTP error -->
            <TextView
                android:id="@+id/tvOtpError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/error_color"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/layoutOtpBoxes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Timer + resend row -->
            <LinearLayout
                android:id="@+id/layoutResendRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvOtpError"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvResendLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend code in "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:40"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <!-- Resend button (shown after timer expires) -->
            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend OTP"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:paddingVertical="4dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/layoutResendRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Verify button — now anchored to tvResendOtp, not layoutResendRow -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyOtp"
                style="@style/ChalRide.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Verify &amp; Continue"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/tvResendOtp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Change number -->
            <TextView
                android:id="@+id/tvChangeNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change phone number"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnVerifyOtp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Shared progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/brand_primary"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnSendOtp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>