<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <!-- Subtle top decorative bar accent (rider purple) -->
    <View
        android:id="@+id/topAccentBar"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@drawable/gradient_rider_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Middle ring -->
    <View
        android:id="@+id/glowRingMiddle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_glow_ring_middle_rider"
        android:alpha="0.55"
        app:layout_constraintBottom_toTopOf="@id/tvStatusBadge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/topAccentBar"
        app:layout_constraintVertical_bias="0.42"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Icon circle background -->
    <View
        android:id="@+id/iconCircleBg"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_icon_circle_rider"
        app:layout_constraintBottom_toBottomOf="@id/glowRingMiddle"
        app:layout_constraintEnd_toEndOf="@id/glowRingMiddle"
        app:layout_constraintStart_toStartOf="@id/glowRingMiddle"
        app:layout_constraintTop_toTopOf="@id/glowRingMiddle" />

    <!--
        Dynamic emoji — set by RideCancelledFragment.kt based on CancelReason.
        Sits centred inside the icon circle, no text changes needed here.
    -->
    <TextView
        android:id="@+id/tvEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="44sp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@id/iconCircleBg"
        app:layout_constraintEnd_toEndOf="@id/iconCircleBg"
        app:layout_constraintStart_toStartOf="@id/iconCircleBg"
        app:layout_constraintTop_toTopOf="@id/iconCircleBg" />

    <!-- Status chip / badge -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_status_badge_rider"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:text="TRIP UPDATE"
        android:textColor="@color/rider_color"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:fontFamily="@font/geist_mono_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glowRingMiddle" />

    <!-- Title — set dynamically by Kotlin -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/geist_bold"
        android:letterSpacing="-0.02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatusBadge" />

    <!-- Message — set dynamically by Kotlin -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="40dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.55"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/geist_mono_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Divider line -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/divider_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMessage" />

    <!-- Info card: reassures rider no charges were applied -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/infoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_info_card"
        android:paddingVertical="20dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <ImageView
            android:id="@+id/icInfoDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_rider_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvInfoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="No charges have been applied"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/geist_medium"
            app:layout_constraintStart_toEndOf="@id/icInfoDot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvInfoSub" />

        <TextView
            android:id="@+id/tvInfoSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Your payment method was not charged"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/geist_regular"
            app:layout_constraintStart_toEndOf="@id/icInfoDot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvInfoLabel"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Primary CTA Button (rider purple) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoHome"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="36dp"
        android:text="Back to Home"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:fontFamily="@font/geist_semibold"
        android:textColor="@color/white"
        app:backgroundTint="@color/rider_color"
        app:cornerRadius="14dp"
        app:rippleColor="#33FFFFFF"
        app:icon="@drawable/ic_home_outline"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@color/white"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>