<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ChalRide" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/bg_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ChalRide.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/bg_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.ChalRide</item>
    </style>

    <style name="ChalRide.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ChalRide.Button.Rider" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/rider_color</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="ChalRide.Button.Driver" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/driver_color</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="ChalRide.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ChalRide.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ChalRide.InputShape</item>
    </style>

    <style name="ShapeAppearance.ChalRide.InputShape" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="DriverWarningDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <style name="TransparentDialog" parent="android:Theme.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.85</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="ChalRide.LogoutDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <!-- dim behind dialog -->
        <item name="android:backgroundDimAmount">0.65</item>

        <!-- THIS is what MaterialAlertDialog actually uses for panel colour -->
        <item name="colorSurface">#1E1E35</item>

        <!-- Shape: 20 dp rounded corners -->
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ChalRide.DialogShape</item>

        <!-- Title text: white, slightly larger -->
        <item name="materialAlertDialogTitleTextStyle">
            @style/ChalRide.LogoutDialog.TitleText
        </item>

        <!-- Body/message text: muted secondary -->
        <item name="materialAlertDialogBodyTextStyle">
            @style/ChalRide.LogoutDialog.BodyText
        </item>

        <!-- "Log out" button: red accent so it reads as destructive -->
        <item name="buttonBarPositiveButtonStyle">
            @style/ChalRide.LogoutDialog.Button.Positive
        </item>

        <!-- "Cancel" button: subtle/muted -->
        <item name="buttonBarNegativeButtonStyle">
            @style/ChalRide.LogoutDialog.Button.Negative
        </item>

    </style>

    <style name="ShapeAppearance.ChalRide.DialogShape" parent="">
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Dialog title: bold white -->
    <style name="ChalRide.LogoutDialog.TitleText"
        parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Dialog body: soft secondary text -->
    <style name="ChalRide.LogoutDialog.BodyText"
        parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#B0B0C3</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- "Log out" = red/destructive text button -->
    <style name="ChalRide.LogoutDialog.Button.Positive"
        parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#FF4757</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="rippleColor">#33FF4757</item>
    </style>

    <!-- "Cancel" = muted/secondary text button -->
    <style name="ChalRide.LogoutDialog.Button.Negative"
        parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#B0B0C3</item>
        <item name="android:textSize">15sp</item>
        <item name="rippleColor">#22FFFFFF</item>
    </style>

</resources>