<?xml version="1.0" encoding="utf-8"?>
<!--
    FIXED: Removed the broken second layer-list item.
    The old gradient item had no android:top offset so it painted
    from y=0 covering the whole card with a purple/blue wash.
    Now we use a single clean shape with a stroke border.
    The top accent is handled in themes.xml via colorSurface/backgroundTint.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="20dp" />

    <!-- Deep navy card — matches bg_card / input_bg palette -->
    <solid android:color="#1E1E35" />

    <!-- Subtle white border so dialog lifts off the dimmed BG -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />

</shape>