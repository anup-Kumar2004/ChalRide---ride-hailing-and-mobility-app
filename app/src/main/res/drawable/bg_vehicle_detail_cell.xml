<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- bg_surface (#16213E) at full opacity — slightly lighter than bg_card -->
    <solid android:color="#16213E"/>

    <!-- brand_primary at ~18 % opacity — subtle purple border -->
    <stroke
        android:width="1dp"
        android:color="#2D6C63FF"/>

    <!-- 12dp corners — softer than outer card, creates depth hierarchy -->
    <corners android:radius="12dp"/>

</shape>